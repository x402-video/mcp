{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.x402-video/seedance-video-generation",
  "title": "x402 Video — AI Video Generation (pay-per-call, no account)",
  "description": "Pay-per-call AI video generation (Seedance text-to-video) via x402. USDC on Base, no API key.",
  "repository": {
    "url": "https://github.com/x402-video/mcp",
    "source": "github"
  },
  "websiteUrl": "https://x402video.com",
  "version": "0.1.3",
  "packages": [
    {
      "registryType": "npm",
      "registryBaseUrl": "https://registry.npmjs.org",
      "identifier": "x402-video-mcp",
      "version": "0.1.3",
      "transport": {
        "type": "stdio"
      },
      "environmentVariables": [
        {
          "name": "BUYER_PRIVATE_KEY",
          "description": "Spending wallet private key (USDC on Base). Only required for the paid generate_video tool; quotes and polling work without it.",
          "isRequired": false,
          "isSecret": true,
          "format": "string"
        },
        {
          "name": "MAX_USD_PER_CALL",
          "description": "Hard spend guard in USD — generate_video refuses quotes above this (default 5).",
          "isRequired": false,
          "format": "number"
        },
        {
          "name": "GATEWAY_URL",
          "description": "Alternate gateway instance (default https://api.x402video.com).",
          "isRequired": false,
          "format": "string"
        }
      ]
    }
  ],
  "_meta": {
    "io.modelcontextprotocol.registry/publisher-provided": {
      "categories": ["video", "ai", "payments"],
      "tags": [
        "video-generation",
        "text-to-video",
        "ai-video",
        "seedance",
        "x402",
        "usdc",
        "base",
        "pay-per-call",
        "agent-payments",
        "no-api-key",
        "micropayments"
      ],
      "freeTools": ["list_skus", "get_stats", "quote_price", "get_job"],
      "license": "MIT"
    }
  }
}
